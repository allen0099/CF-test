/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "facebook-fix",
  "main": "index.js",
  "compatibility_date": "2025-09-27",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    // The path to the directory containing the `index.html` file to be served at `/`
    "directory": "./public",
  },
  "observability": {
    "enabled": true,
  },
  /**
   * Smart Placement
   * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
   */
  // "placement": {  "mode": "smart" }
  /**
   * KV Namespaces
   * https://developers.cloudflare.com/kv/
   */
  "kv_namespaces": [
    { "binding": "METADATA_CACHE", "id": "<METADATA_CACHE_KV_ID>" },
    { "binding": "BLOCKLIST", "id": "<BLOCKLIST_KV_ID>" }
  ],
  /**
   * Environment Variables
   * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
   *
   * Secrets (set via `npx wrangler secret put <NAME>`):
   *   - TELEGRAM_BOT_TOKEN: Telegram Bot API token
   *   - TELEGRAM_CHAT_ID: Telegram chat/group ID for log messages
   *   - TELEGRAM_WEBHOOK_SECRET: Secret token for webhook verification
   */
  "vars": {
    "TELEGRAM_LOG_LEVEL": "all",
    "CACHE_TTL": "3600",
    "TELEGRAM_ADMIN_IDS": "",
    "TELEGRAM_THREAD_ID": ""
  },
}
